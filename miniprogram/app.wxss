/* 全局样式 - 深色金融主题 */
page {
  background-color: #0A0E17;
  color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 页面容器 */
.page {
  padding: 24rpx 32rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 页面头部 */
.page-header {
  margin-bottom: 32rpx;
}
.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.page-sub {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

/* 卡片 */
.card {
  background: #111827;
  border: 1rpx solid #1F2937;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  transition: all 0.2s;
}
.card:active {
  background: #1A2636;
  border-color: #00E5FF;
}
.card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #00E5FF, #8B5CF6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #FFFFFF;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.card-info {
  flex: 1;
  min-width: 0;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.card-desc {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card-arrow {
  color: #4B5563;
  font-size: 40rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 分组标题 */
.group-label {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 600;
  margin: 24rpx 0 16rpx;
  letter-spacing: 1rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 96rpx;
  color: #374151;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #6B7280;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(90deg, #00E5FF, #8B5CF6);
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
}
.btn-primary:active {
  opacity: 0.85;
}

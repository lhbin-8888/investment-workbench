/* 行业个股分析页 */
.page {
  padding: 24rpx 32rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.page-header {
  margin-bottom: 32rpx;
}
.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.page-sub {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}
.card {
  background: #111827;
  border: 1rpx solid #1F2937;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.card:active {
  background: #1A2636;
  border-color: #00E5FF;
}
.card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #00E5FF, #8B5CF6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #FFFFFF;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.card-info {
  flex: 1;
  min-width: 0;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.card-desc {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card-arrow {
  color: #4B5563;
  font-size: 40rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
/* 通用详情页 */
.page {
  padding: 24rpx 32rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.page-header {
  margin-bottom: 32rpx;
}
.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.page-sub {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}
.desc-card {
  background: #111827;
  border: 1rpx solid #1F2937;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
/* 晨报快照提示条 */
.briefing-note {
  background: rgba(0,229,255,0.08);
  border: 1rpx solid #1F2937;
  border-left: 6rpx solid #00E5FF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.briefing-note-date {
  font-size: 26rpx;
  font-weight: 600;
  color: #00E5FF;
  margin-bottom: 8rpx;
}
.briefing-note-text {
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.6;
}
.desc-label {
  font-size: 24rpx;
  color: #00E5FF;
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}
.desc-text {
  font-size: 28rpx;
  color: #D1D5DB;
  line-height: 1.7;
}
.tpl-card {
  background: #111827;
  border: 1rpx solid #1F2937;
  border-radius: 20rpx;
  padding: 28rpx;
}
.tpl-label {
  font-size: 24rpx;
  color: #00E5FF;
  font-weight: 600;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}
/* rich-text 内样式 */
.tpl-card rich-text {
  font-size: 28rpx;
  color: #D1D5DB;
  line-height: 1.7;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 96rpx;
  color: #374151;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #6B7280;
}
<view class="page">
  <view class="page-header">
    <view class="page-title">{{name}}</view>
    <view class="page-sub" wx:if="{{parent}}">所属模块：{{parent}}</view>
  </view>

  <view class="desc-card" wx:if="{{desc}}">
    <view class="desc-label">模块说明</view>
    <view class="desc-text">{{desc}}</view>
  </view>

  <view class="briefing-note" wx:if="{{isBriefing}}">
    <view class="briefing-note-date">晨报日期：{{briefingDate}}</view>
    <view class="briefing-note-text">{{briefingNote}}</view>
  </view>

  <view class="tpl-card" wx:if="{{isBriefing}}">
    <view class="tpl-label">晨报全文</view>
    <rich-text nodes="{{html}}"></rich-text>
  </view>

  <view class="tpl-card" wx:if="{{isTemplate}}">
    <view class="tpl-label">模板预览</view>
    <rich-text nodes="{{html}}"></rich-text>
  </view>

  <view class="empty-state" wx:if="{{!desc && !isTemplate && !isBriefing}}">
    <view class="empty-icon">📂</view>
    <view class="empty-text">暂无内容</view>
  </view>
</view>
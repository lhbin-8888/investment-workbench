<view class="page">
  <view class="page-header">
    <view class="page-title">投资策略分析</view>
    <view class="page-sub">回测 · 组合 · 风控 · 笔记</view>
  </view>
  <view class="card" wx:for="{{items}}" wx:key="name" bindtap="onTap" data-name="{{item.name}}">
    <view class="card-icon">{{item.icon}}</view>
    <view class="card-info">
      <view class="card-name">{{item.name}}</view>
      <view class="card-desc">{{item.desc}}</view>
    </view>
    <view class="card-arrow">›</view>
  </view>
</view>
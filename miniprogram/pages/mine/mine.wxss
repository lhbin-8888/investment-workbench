/* 我的页 */
.page {
  padding: 24rpx 32rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.profile {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #0D1220 0%, #111827 100%);
  border: 1rpx solid #1F2937;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 32rpx;
}
.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #00E5FF, #8B5CF6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-right: 24rpx;
}
.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.profile-slogan {
  font-size: 24rpx;
  color: #00E5FF;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}
.group-label {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 600;
  margin: 24rpx 0 16rpx;
  letter-spacing: 1rpx;
}
.status-card {
  display: flex;
  align-items: center;
  background: #111827;
  border: 1rpx solid #1F2937;
  border-radius: 20rpx;
  padding: 28rpx;
}
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #10B981;
  margin-right: 16rpx;
  box-shadow: 0 0 12rpx rgba(16, 185, 129, 0.6);
}
.status-text {
  font-size: 28rpx;
  color: #10B981;
}
.card {
  background: #111827;
  border: 1rpx solid #1F2937;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-name {
  font-size: 28rpx;
  color: #FFFFFF;
}
.card-value {
  font-size: 26rpx;
  color: #9CA3AF;
}
.footer {
  text-align: center;
  font-size: 22rpx;
  color: #4B5563;
  margin-top: 60rpx;
}